<!--
  照搬自 StarPie 的 WinPieGestures/OcrResultWindow.xaml —— 布局、圆角、阴影、按钮一字未改。
  宿主自带的「截屏识字」认完字弹出的就是这个窗口；插件要的是同一个窗口，不是"也弹一个窗口"。

  改动只有两处，都是被迫的：
  1. x:Class 换成插件的命名空间（照搬的代码都住在 StarPie.Plugin.PrismShot.Upstream 下）
  2. 「⚙️ 接口设置」按钮的文案与提示 —— 它点开的不再是宿主的 OcrSettingsDialog，
     而是直接在资源管理器里定位 config.json。原因写在 OcrResultWindow.xaml.cs 的
     SettingsButton_Click 上，不在这里重复。

  颜色一律用 DynamicResource 引用宿主的画笔键，一个色值都没写死：
  在 StarPie 里跑的时候，这些键会解析到宿主的 App.xaml / AppThemeManager 写进去的当前主题，
  于是窗口自动跟随宿主是亮色还是暗色、以及用户挑的那套配色。
  只有在没有宿主 Application 的场合（独立验证桩）才由 OcrTheme 注入一组兜底色。
-->
<Window x:Class="StarPie.Plugin.PrismShot.Upstream.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarPie OCR 识别结果"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="540"
        SizeToContent="Height"
        MaxHeight="520"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Name="ResultHeaderTitleText" Text="StarPie OCR 文字识别结果" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />
                    <!--
                      MaxWidth + 省略号是补上游的一个小毛病：引擎名会很长
                      （"🤖 AI 视觉大模型 (deepseek-v4-flash-vision-exp) · 2707ms"），
                      徽章又是自适应的，于是它会把标题挤到屏幕外、自己也被裁掉一半。
                      完整名字挂到 ToolTip 上，一眼看不全但拿得到。
                    -->
                    <Border Name="EngineBadge" Background="{DynamicResource NavTabActiveBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" MaxWidth="290">
                        <TextBlock Name="EngineText" Text="本地离线引擎" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0" FontSize="12" Cursor="Hand" Click="CloseButton_Click" />
            </Grid>

            <!-- 统计标签 -->
            <Grid Margin="0,0,0,6">
                <TextBlock Name="CharCountText" Text="提取文本 (共 0 字符):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Name="ClipboardStatusText" Text="已自动存入系统剪贴板" FontSize="11" Foreground="#10B981" HorizontalAlignment="Right" />
            </Grid>

            <!-- 文本展示与编辑区 -->
            <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                <TextBox Name="ResultTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="12"
                         FontFamily="Segoe UI, Microsoft YaHei"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="120"
                         MaxHeight="260" />
            </Border>

            <!-- 操作按钮底栏 -->
            <Grid Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Name="CopyButton" Content="📋 复制文本" Height="30" Padding="14,0" Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="CopyButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Name="SearchButton" Content="🔍 网页搜索" Height="30" Padding="12,0" Margin="8,0,0,0" Background="{DynamicResource SubtleCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" Cursor="Hand" Click="SearchButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Name="SettingsButton" Content="⚙️ 接口设置" Height="30" Padding="12,0" Margin="8,0,0,0" Background="{DynamicResource SubtleCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" Cursor="Hand" Click="SettingsButton_Click" ToolTip="打开 StarPie 的 config.json —— 引擎、模型、密钥都在里面（插件改不了宿主的设置窗口，只能把文件指给你）">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <Button Name="CloseDoneButton" Content="完成 [ESC]" Height="30" Padding="14,0" Background="{DynamicResource SubtleCardBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="CloseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
