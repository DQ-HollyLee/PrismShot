{
  "schemaVersion": 1,

  "id": "dev.prismshot.starpie",
  "name": "PrismShot HDR 截图",
  "description": "让 StarPie 轮盘直接调用 PrismShot 截图：HDR 屏幕上不过曝、SDR 上也正常，并可选地把选区交给 StarPie 识别文字。",
  "author": "PrismShot",
  "homepage": "https://github.com/prismshot/PrismShot",
  "license": "MIT",
  "version": "1.0.0",

  "apiVersion": "1.6",
  "minHostVersion": "1.8.0-beta.1",

  "targetFramework": "net8.0-windows10.0.19041.0",
  "platform": "win-x64",

  "assembly": "StarPie.Plugin.PrismShot.dll",
  "entryType": "StarPie.Plugin.PrismShot.PrismShotPlugin",

  "capabilities": ["Process", "FileSystem", "Network", "Clipboard", "ScreenCapture"],

  "contributions": {
    "actions": true,
    "icons": false,
    "i18n": false
  },

  "tags": ["截图", "HDR", "OCR", "录屏"]
}
