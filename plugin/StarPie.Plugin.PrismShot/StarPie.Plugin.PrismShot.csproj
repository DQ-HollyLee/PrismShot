<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      为什么从 net8.0-windows 抬到 net8.0-windows10.0.19041.0：
      照搬过来的 OCR 源码要用到两样东西 —— System.Drawing.Bitmap（识别前的图像预处理全在它上面）
      与 Windows.Media.Ocr 的 WinRT 投影（本地离线引擎）。前者只在 Microsoft.WindowsDesktop.App
      里，后者要求 TFM 带平台版本号，net8.0-windows（无版本号）两者都拿不到。

      抬到 19041 而不是更高，是因为宿主自己的 TFM 就是 19041，而宿主的插件闸门判定的是
      「插件 TFM 不得高于宿主」（TargetFrameworkInfo.IsCompatible：平台版本 p <= h）。
      持平通过，高一点就被拒载 —— 所以这里不是「尽量新」，而是「恰好等于宿主」。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <!-- 只为拿到 System.Drawing.Common：它属于 Microsoft.WindowsDesktop.App 共享框架，
         用 FrameworkReference 而不是 NuGet 包，产物目录里就不会多出一份 System.Drawing.dll。 -->
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      结果窗口是 WPF。宿主"截屏识字"弹的 OcrResultWindow 就是 .xaml，要一模一样就得能编译 XAML。
      PresentationFramework / PresentationCore 与 WinForms 同属 Microsoft.WindowsDesktop.App
      共享框架，所以开了它也不会往产物目录里多塞任何 dll。
    -->
    <UseWPF>true</UseWPF>

    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>

    <AssemblyName>StarPie.Plugin.PrismShot</AssemblyName>
    <RootNamespace>StarPie.Plugin.PrismShot</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      插件的 SDK 位置由 StarPiePluginSdkDir 指定，默认取同级 reference 下克隆的 StarPie 仓库。
      放在属性里而不是写死路径，是因为不同人克隆的位置不一样；构建脚本会显式传进来。
      构造失败时的报错信息写在下面那个 Target 里，免得只留一句「找不到文件」。
    -->
    <StarPiePluginSdkDir Condition="'$(StarPiePluginSdkDir)' == ''">$(MSBuildThisFileDirectory)..\..\reference\StarPie\plugin\sdk\StarPie.Plugin.Abstractions</StarPiePluginSdkDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      <Private>false</Private> 是硬性要求：产物里多出一份 StarPie.Plugin.Abstractions.dll，
      宿主加载时会因为类型来自两个不同程序集而报「无法转换为 IStarPiePlugin」。
      这不是能靠删文件绕过去的问题，必须在引用上关掉复制。
    -->
    <ProjectReference Include="$(StarPiePluginSdkDir)\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 裸 DLL 分发时的静态识别兜底。值必须与 plugin.json 保持一致。 -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="dev.prismshot.starpie" />
    <AssemblyMetadata Include="StarPiePluginName" Value="PrismShot HDR 截图" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="Process;FileSystem;Network;Clipboard;ScreenCapture" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/prismshot/PrismShot" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
